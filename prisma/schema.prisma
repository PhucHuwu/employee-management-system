model PositionSetting {
  id            String       @id @default(uuid()) @db.Uuid
  userType      String       @map("user_type") @db.VarChar(50)
  lmsConfig     String?      @map("lms_config")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  subPositionId String       @map("sub_position_id") @db.Uuid
  subPosition   SubPosition  @relation(fields: [subPositionId], references: [id], onDelete: Restrict)

  @@map("position_settings")
}

model EmployeeSkill {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  employeeId String   @map("employee_id") @db.Uuid
  skillId    String   @map("skill_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([employeeId, skillId])
  @@map("employee_skills")
}

model CandidateSkill {
  id         String    @id @default(uuid()) @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  candidateId String   @map("candidate_id") @db.Uuid
  skillId    String    @map("skill_id") @db.Uuid
  candidate  Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  skill      Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([candidateId, skillId])
  @@map("candidate_skills")
}

enum CapabilityType {
  POINT
  TEXT
}

model Capability {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  from      String?  @db.VarChar(255)
  guideline String?
  type      CapabilityType
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  items     CapabilitySettingItem[]
  reviewInternDetails ReviewInternDetail[]

  @@map("capabilities")
}

model CapabilitySetting {
  id        String                  @id @default(uuid()) @db.Uuid
  userType  String                  @map("user_type") @db.VarChar(50)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  positionId String                 @map("position_id") @db.Uuid
  position  Position                @relation(fields: [positionId], references: [id], onDelete: Restrict)
  items     CapabilitySettingItem[]

  @@unique([userType, positionId])
  @@map("capability_settings")
}

model CapabilitySettingItem {
  id                   String            @id @default(uuid()) @db.Uuid
  coefficient          Float             @default(1)
  guideline            String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  capabilitySettingId  String            @map("capability_setting_id") @db.Uuid
  capabilityId         String            @map("capability_id") @db.Uuid
  capabilitySetting    CapabilitySetting @relation(fields: [capabilitySettingId], references: [id], onDelete: Restrict)
  capability           Capability        @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@unique([capabilitySettingId, capabilityId])
  @@map("capability_setting_items")
}

model ScoreSetting {
  id         String   @id @default(uuid()) @db.Uuid
  userType   String   @map("user_type") @db.VarChar(50)
  scoreFrom  Float    @map("score_from")
  scoreTo    Float    @map("score_to")
  level      String   @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  positionId String   @map("position_id") @db.Uuid
  position   Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@unique([userType, positionId, scoreFrom, scoreTo])
  @@map("score_settings")
}

model ProjectTask {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  code        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  projectId   String   @map("project_id") @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  timesheetEntries TimesheetEntry[]

  @@index([projectId])
  @@map("project_tasks")
}

model TimesheetEntry {
  id                  String               @id @default(uuid()) @db.Uuid
  entryDate           DateTime             @map("entry_date") @db.Date
  normalWorkingTime   Float                @default(0) @map("normal_working_time")
  overtime            Float                @default(0)
  note                String?
  status              TimesheetEntryStatus @default(DRAFT)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  employeeId          String               @map("employee_id") @db.Uuid
  projectId           String               @map("project_id") @db.Uuid
  taskId              String               @map("task_id") @db.Uuid
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task                ProjectTask          @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([employeeId, entryDate])
  @@index([projectId, entryDate])
  @@map("timesheet_entries")
}

model ReviewIntern {
  id          String             @id @default(uuid()) @db.Uuid
  month       Int
  year        Int
  totalScore  Float?             @map("total_score")
  level       String?            @db.VarChar(50)
  status      ReviewInternStatus @default(DRAFT)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  internId    String             @map("intern_id") @db.Uuid
  reviewerId  String             @map("reviewer_id") @db.Uuid
  intern      Employee           @relation(fields: [internId], references: [id], onDelete: Restrict, name: "InternReviews")
  reviewer    Employee           @relation(fields: [reviewerId], references: [id], onDelete: Restrict, name: "ReviewerReviews")
  details     ReviewInternDetail[]

  @@unique([internId, month, year])
  @@index([reviewerId, status])
  @@map("review_interns")
}

model ReviewInternDetail {
  id             String       @id @default(uuid()) @db.Uuid
  score          Float?
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  reviewInternId String       @map("review_intern_id") @db.Uuid
  capabilityId   String       @map("capability_id") @db.Uuid
  reviewIntern   ReviewIntern @relation(fields: [reviewInternId], references: [id], onDelete: Restrict)
  capability     Capability   @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@unique([reviewInternId, capabilityId])
  @@map("review_intern_details")
}

model TeamBuildingRequest {
  id           String            @id @default(uuid()) @db.Uuid
  note         String?
  totalMoney   Decimal?          @map("total_money") @db.Decimal(18, 2)
  attachmentUrl String?          @map("attachment_url")
  status       TeamBuildingStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  pmId         String            @map("pm_id") @db.Uuid
  projectId    String            @map("project_id") @db.Uuid
  pm           Employee          @relation(fields: [pmId], references: [id], onDelete: Restrict)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  participants TeamBuildingParticipant[]

  @@index([projectId, status])
  @@map("team_building_requests")
}

model TeamBuildingParticipant {
  id         String              @id @default(uuid()) @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at")
  requestId  String              @map("request_id") @db.Uuid
  employeeId String              @map("employee_id") @db.Uuid
  request    TeamBuildingRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([requestId, employeeId])
  @@map("team_building_participants")
}

model WorkingTimeRequest {
  id         String              @id @default(uuid()) @db.Uuid
  template   WorkingTimeTemplate
  status     WorkingTimeStatus   @default(PENDING)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  employeeId String              @map("employee_id") @db.Uuid
  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
  @@map("working_time_requests")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(255)
  value     String
  category  String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("system_settings")
}

model LeaveType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  color     String?  @db.VarChar(7)
  isPaid    Boolean  @default(true) @map("is_paid")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leave_types")
}

model OffDay {
  id        String   @id @default(uuid()) @db.Uuid
  offDate   DateTime @map("off_date") @db.Date
  name      String   @db.VarChar(255)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([offDate])
  @@map("off_days")
}

model ProjectMemberShadow {
  id               String      @id @default(uuid()) @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  projectMemberId  String      @map("project_member_id") @db.Uuid
  targetEmployeeId String      @map("target_employee_id") @db.Uuid
  projectMember    ProjectMember @relation(fields: [projectMemberId], references: [id], onDelete: Restrict)
  targetEmployee   Employee      @relation(fields: [targetEmployeeId], references: [id], onDelete: Restrict, name: "ShadowTargetEmployee")

  @@unique([projectMemberId, targetEmployeeId])
  @@map("project_member_shadows")
}
